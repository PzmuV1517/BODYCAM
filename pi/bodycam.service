[Unit]
Description=BODYCAM camera + person detection UDP streamer
After=NetworkManager.service
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
# No Wi-Fi power saving (avoids latency spikes/drops). CPU governor left on default: less heat, quieter fan.
ExecStartPre=-/bin/sh -c 'echo ondemand > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor'
ExecStartPre=-/usr/sbin/iw dev wlan0 set power_save off
ExecStart=/usr/bin/python3 /opt/bodycam/server.py
Restart=always
TimeoutStopSec=5
RestartSec=1
Nice=-10

[Install]
WantedBy=multi-user.target
